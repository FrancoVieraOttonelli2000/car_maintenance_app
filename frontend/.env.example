# Copia este archivo como frontend/.env y ajusta los valores.
# Después de cambiarlo, reinicia Expo con: npx expo start -c

# URL del backend.
# - Emulador de Android: no hace falta (se usa http://10.0.2.2:5000/api)
# - Móvil real en tu wifi: la IP de tu PC, p. ej. http://192.168.1.50:5000/api
#   (en Windows la ves con `ipconfig`, "Dirección IPv4")
# - Producción: la URL HTTPS de tu servidor
EXPO_PUBLIC_API_URL=

# Clave publicable de Stripe (pk_test_... o pk_live_...). Opcional.
EXPO_PUBLIC_STRIPE_PK=
