# Copia este archivo como backend/.env y rellena los valores.
PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=car_maintenance_app

# Cadena larga y aleatoria. Si la cambias, todas las sesiones se cierran.
JWT_SECRET=

CLAUDE_API_KEY=
STRIPE_SECRET_KEY=

# Orígenes permitidos para la versión web (Expo web), separados por comas.
# La app nativa no se ve afectada. Si se deja vacío: localhost:8081 y :19006.
CORS_ORIGINS=
